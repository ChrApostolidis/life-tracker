{
  "manifest_version": 3,
  "name": "Life Tracker Quick Capture",
  "version": "0.1.0",
  "key": "",
  "description": "Capture a task into Life Tracker from anywhere in Chrome.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Life Tracker quick capture"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": ["storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open quick capture"
    }
  }
}
